# FIGURE 1 — Raw sensor data (paper Fig 6)
# ══════════════════════════════════════════════════════════════════════════════

def figure1_sensor_data():
    odom_df = pd.read_csv(p('odom'))
    imu_df  = pd.read_csv(p('imu'))

    ekf_df  = pd.read_csv(p('ekf_fused_output'))
    t_grid  = get_timestamp(ekf_df)
    gt_x, gt_y = load_gt(t_grid)

    # IMU dead-reckoning trace — helper already existed in this file but was
    # never actually called anywhere until now. Init pose from GT (matching
    # how every other pipeline stage initializes), falling back to odom's
    # own start if no GT available.
    if gt_x is not None:
        init_x, init_y = float(gt_x[0]), float(gt_y[0])
    else:
        init_x, init_y = float(odom_df['pos_x'].iloc[0]), float(odom_df['pos_y'].iloc[0])
    init_theta = 0.0
    imu_x, imu_y, _ = imu_dead_reckoning(imu_df, init_x, init_y, init_theta)

    # NOTE: paper Fig 6 also shows a 4th "Ladir" (LiDAR) standalone trace.
    # This project's pipeline never produces a standalone LiDAR-only
    # position estimate (LiDAR is only ever used as a complementary
    # correction on top of RNN output, never alone) — that's a separate
    # piece of work, not built here. Only 3 of the paper's 4 traces are
    # real; a 4th is not fabricated to fill the gap.
    fig, ax = plt.subplots(1, 1, figsize=(9, 7))
    fig.suptitle('Figure 1: Raw Sensor Data Collection (paper Fig 6)',
                 fontsize=13, fontweight='bold')

    ref_x = [odom_df['pos_x'].values]
    ref_y = [odom_df['pos_y'].values]
    if gt_x is not None:
        ref_x.append(gt_x); ref_y.append(gt_y)

    if gt_x is not None:
        ax.plot(gt_x, gt_y, color='tab:blue', linewidth=1.5, label='Trajectory (GT)')
    ax.plot(odom_df['pos_x'], odom_df['pos_y'], color='tab:orange',
            linewidth=1, alpha=0.85, label='Odometer')
    ax.plot(imu_x, imu_y, color='tab:green', linewidth=1, alpha=0.85, label='IMU')

    adaptive_xy_limits(ax, ref_x, ref_y)
    annotate_offchart(ax, 'IMU', imu_x, imu_y, ref_x, ref_y)

    ax.set_xlabel('x (m)')
    ax.set_ylabel('y (m)')
    ax.legend()
    ax.grid(True, alpha=0.3)

    plt.tight_layout()
    save('paper_figure1_sensor_data.png')


# ══════════════════════════════════════════════════════════════════════════════
# FIGURE 2 — S-G filtering (paper Fig 7-8)
# ══════════════════════════════════════════════════════════════════════════════

def figure2_sg_filtering():
    odom_raw = pd.read_csv(p('odom'))
    odom_flt = pd.read_csv(p('odom_filtered'))
    imu_raw  = pd.read_csv(p('imu'))
    imu_flt  = pd.read_csv(p('imu_filtered'))

    ekf_df = pd.read_csv(p('ekf_fused_output'))
    t_grid = get_timestamp(ekf_df)
    gt_x, gt_y = load_gt(t_grid)

    init_x = float(gt_x[0]) if gt_x is not None else float(odom_raw['pos_x'].iloc[0])
    init_y = float(gt_y[0]) if gt_y is not None else float(odom_raw['pos_y'].iloc[0])

    imu_raw_x, imu_raw_y, _ = imu_dead_reckoning(imu_raw, init_x, init_y, 0.0)
    imu_flt_x, imu_flt_y, _ = imu_dead_reckoning(imu_flt, init_x, init_y, 0.0)

    fig, axes = plt.subplots(1, 2, figsize=(14, 6))
    fig.suptitle('Figure 2: Savitzky-Golay Filtering (paper Fig 7-8)',
                 fontsize=13, fontweight='bold')

    # ── Left panel: paper Fig 7 style — per-sensor positioning ERROR vs
    # time (raw, pre-filtering), using GT as reference. Paper's 3rd series
    # (LiDAR) is skipped — no standalone LiDAR position estimate exists in
    # this pipeline (see figure1's note), not fabricated here either.
    if gt_x is not None:
        n = min(len(odom_raw), len(imu_raw_x), len(gt_x))
        odom_err = pos_error(odom_raw['pos_x'].values[:n], odom_raw['pos_y'].values[:n],
                             gt_x[:n], gt_y[:n])
        imu_err  = pos_error(imu_raw_x[:n], imu_raw_y[:n], gt_x[:n], gt_y[:n])
        axes[0].plot(odom_err, color='tab:blue',  marker='o', markevery=max(1, n//30),
                    markersize=4, linewidth=1, label='Odometer Error')
        axes[0].plot(imu_err,  color='tab:orange', marker='s', markevery=max(1, n//30),
                    markersize=4, linewidth=1, linestyle='--', label='IMU Error')
        axes[0].set_xlabel('Time step')
        axes[0].set_ylabel('Error (m)')
        axes[0].set_title('Positioning Errors of Sensors (paper Fig 7)')
        axes[0].legend()
        axes[0].grid(True, alpha=0.3)
    else:
        axes[0].text(0.5, 0.5, 'No ground truth available', ha='center', va='center',
                    transform=axes[0].transAxes)

    # ── Right panel: paper Fig 8 style — FILTERED trajectories (x vs y),
    # odometer + IMU dead-reckoning on the filtered signals.
    # FIX (reasonable reviewer suggestion): previously only showed filtered
    # data, so the actual smoothing benefit wasn't visible in this panel —
    # it existed already split across Fig 1 (raw only) and this panel
    # (filtered only), but never overlaid directly for comparison. Adding
    # faint raw traces underneath the filtered ones makes the effect
    # visible in one place without needing to flip between figures.
    imu_raw_x_r, imu_raw_y_r = imu_raw_x, imu_raw_y  # reuse, already computed above
    axes[1].plot(odom_raw['pos_x'], odom_raw['pos_y'], color='tab:blue',
                linewidth=0.8, alpha=0.35, label='Odometer (raw)')
    axes[1].plot(imu_raw_x_r, imu_raw_y_r, color='tab:orange',
                linewidth=0.8, alpha=0.35, linestyle=':', label='IMU (raw)')
    axes[1].plot(odom_flt['pos_x'], odom_flt['pos_y'], color='tab:blue',
                linewidth=1.5, label='Odometer (filtered)')
    axes[1].plot(imu_flt_x, imu_flt_y, color='tab:orange', linewidth=1.5,
                linestyle='--', label='IMU (filtered)')
    ref_x = [odom_flt['pos_x'].values]
    ref_y = [odom_flt['pos_y'].values]
    if gt_x is not None:
        ref_x.append(gt_x); ref_y.append(gt_y)
    adaptive_xy_limits(axes[1], ref_x, ref_y)
    annotate_offchart(axes[1], 'IMU', imu_flt_x, imu_flt_y, ref_x, ref_y)
    axes[1].set_xlabel('x (m)')
    axes[1].set_ylabel('y (m)')
    axes[1].set_title('Raw vs Filtered Data (paper Fig 8)')
    axes[1].legend(fontsize=8)
    axes[1].grid(True, alpha=0.3)

    plt.tight_layout()
    save('paper_figure2_sg_filtering.png')


# ══════════════════════════════════════════════════════════════════════════════
# FIGURE 3 — EKF trajectory + GT error (paper Fig 12)
# ══════════════════════════════════════════════════════════════════════════════

def figure3_ekf_trajectory():
    ekf_df = pd.read_csv(p('ekf_fused_output'))
    imu_df = pd.read_csv(p('imu_filtered'))
    t_grid = get_timestamp(ekf_df)
    gt_x, gt_y = load_gt(t_grid)

    init_x = float(gt_x[0]) if gt_x is not None else float(ekf_df['odom_x'].iloc[0])
    init_y = float(gt_y[0]) if gt_y is not None else float(ekf_df['odom_y'].iloc[0])
    imu_x, imu_y, _ = imu_dead_reckoning(imu_df, init_x, init_y, 0.0)

    fig, axes = plt.subplots(1, 2, figsize=(14, 6))
    fig.suptitle('Figure 3: EKF Fusion Results (paper Fig 12)',
                 fontsize=13, fontweight='bold')

    # Trajectory with GT — paper Fig 12 style: Odometer/IMU as scatter
    # markers, EKF as a line, matching the paper's own visual distinction
    # between "raw sensor" series (markers) and "fused estimate" (line).
    axes[0].scatter(ekf_df['odom_x'], ekf_df['odom_y'], color='tab:blue',
                    s=10, alpha=0.6, label='Odometer')
    axes[0].scatter(imu_x, imu_y, color='tab:orange', s=10, marker='s',
                    alpha=0.6, label='IMU')
    axes[0].plot(ekf_df['ekf_x'], ekf_df['ekf_y'],
                 color='green', linewidth=1.5, linestyle='--', label='EKF')
    if gt_x is not None:
        axes[0].plot(gt_x, gt_y, color='black', linewidth=1,
                     linestyle='-', label='Trajectory (GT)', alpha=0.6)
    ref_x = [ekf_df['odom_x'].values]
    ref_y = [ekf_df['odom_y'].values]
    if gt_x is not None:
        ref_x.append(gt_x); ref_y.append(gt_y)
    adaptive_xy_limits(axes[0], ref_x, ref_y)
    annotate_offchart(axes[0], 'IMU', imu_x, imu_y, ref_x, ref_y)
    axes[0].set_xlabel('X (m)')
    axes[0].set_ylabel('Y (m)')
    axes[0].set_title('EKF Fused Trajectory')
    axes[0].legend()
    axes[0].grid(True)

    # Error vs GT (fix: use GT not odom)
    if gt_x is not None:
        ekf_err  = pos_error(ekf_df['ekf_x'].values,  ekf_df['ekf_y'].values,  gt_x, gt_y)
        odom_err = pos_error(ekf_df['odom_x'].values, ekf_df['odom_y'].values, gt_x, gt_y)
        axes[1].plot(odom_err, color='orange', alpha=0.6,
                     linewidth=0.8, label=f'Odom RMSE={rmse(odom_err):.4f}m')
        axes[1].plot(ekf_err,  color='blue',
                     linewidth=1, label=f'EKF RMSE={rmse(ekf_err):.4f}m')
        axes[1].set_ylabel('Error vs Ground Truth (m)')
    else:
        err = pos_error(ekf_df['ekf_x'].values, ekf_df['ekf_y'].values,
                        ekf_df['odom_x'].values, ekf_df['odom_y'].values)
        axes[1].plot(err, color='red', linewidth=1, label='EKF vs Odom')
        axes[1].set_ylabel('Position error (m)')

    axes[1].set_xlabel('Time step')
    axes[1].set_title('Localization Error vs Ground Truth')
    axes[1].legend()
    axes[1].grid(True)

    plt.tight_layout()
    save('paper_figure3_ekf_trajectory.png')


# ══════════════════════════════════════════════════════════════════════════════
# FIGURE 4 — RNN localization error vs GT (paper Fig 13)
# ══════════════════════════════════════════════════════════════════════════════

def figure4_rnn_results():
    ekf_df = pd.read_csv(p('ekf_fused_output'))
    rnn_df = pd.read_csv(p('rnn_smoothed_output'))
    t_grid = get_timestamp(ekf_df)
    gt_x, gt_y = load_gt(t_grid)

    # FIX: previously truncated to min(len(ekf_df), len(rnn_df)) before
    # interpolating, which shrank the comparison window and made this
    # figure's RMSE (0.6461m EKF / 1.6630m RNN) subtly disagree with the
    # SAME quantities reported in Fig 3/Fig 10 (0.6480m / 1.6695m, computed
    # on the full-length arrays). rnn_x/rnn_y are now interpolated onto the
    # FULL t_grid first (same as every other figure does), so all figures
    # report identical RMSE for the same method on the same session —
    # no more silently-different numbers for "the same" result.
    rnn_native_t = get_timestamp(rnn_df)
    rnn_x = np.interp(t_grid, rnn_native_t, rnn_df['rnn_x'].values)
    rnn_y = np.interp(t_grid, rnn_native_t, rnn_df['rnn_y'].values)

    # FIX #2: np.interp CLAMPS (doesn't extrapolate) for t_grid points
    # before rnn_df's own first timestamp — rnn_df starts WINDOW_SIZE
    # steps later than ekf_df since the RNN needs that much history
    # before it can predict anything. This silently repeats rnn_df's
    # first real value across the leading ~WINDOW_SIZE points, which is
    # harmless for drawing a continuous trajectory line but was corrupting
    # the RNN RMSE reported here: those fabricated-flat points made this
    # figure disagree with rnn_fusion_v2.py's own reported RMSE (1.4310m)
    # and with Fig 5's number for the SAME rnn_smoothed_output data (Fig 5
    # uses rnn_df's own native timestamp grid directly and never hits this
    # issue). Restrict the RNN RMSE specifically to points inside rnn_df's
    # native timestamp range — the plotted line still uses the full
    # (clamped-early) array for visual continuity, only the headline
    # number changes.
    rnn_valid_mask = t_grid >= rnn_native_t[0]

    fig, axes = plt.subplots(1, 2, figsize=(14, 6))
    fig.suptitle('Figure 4: RNN Correction Results (paper Fig 13)',
                 fontsize=13, fontweight='bold')

    # Trajectory
    axes[0].plot(ekf_df['ekf_x'], ekf_df['ekf_y'],
                 color='blue', alpha=0.6, linewidth=1, label='EKF Output')
    axes[0].plot(rnn_x, rnn_y, color='green', linewidth=1.5, label='RNN Corrected')
    if gt_x is not None:
        axes[0].plot(gt_x, gt_y, color='black', linewidth=1,
                     linestyle='--', label='Ground Truth')
    axes[0].set_xlabel('X (m)')
    axes[0].set_ylabel('Y (m)')
    axes[0].set_title('EKF vs RNN vs Ground Truth')
    axes[0].legend()
    axes[0].grid(True)
    axes[0].axis('equal')

    # Localization error vs GT (fix: error not magnitude)
    if gt_x is not None:
        n = len(gt_x)
        ekf_err = pos_error(ekf_df['ekf_x'].values[:n], ekf_df['ekf_y'].values[:n],
                            gt_x[:n], gt_y[:n])
        rnn_err = pos_error(rnn_x[:n], rnn_y[:n], gt_x[:n], gt_y[:n])
        # RMSE excludes the clamped-padding region (see FIX #2 above) —
        # the plotted line itself still shows the full array for visual
        # continuity, only the reported number changes.
        rnn_err_for_rmse = rnn_err[rnn_valid_mask[:n]]
        mark_every = max(1, n // 40)
        axes[1].plot(ekf_err, color='blue', alpha=0.6, linewidth=0.8,
                     marker='o', markevery=mark_every, markersize=4,
                     label=f'EKF error  RMSE={rmse(ekf_err):.4f}m')
        axes[1].plot(rnn_err, color='green', linewidth=1,
                     marker='s', markevery=mark_every, markersize=4,
                     linestyle='--',
                     label=f'RNN error  RMSE={rmse(rnn_err_for_rmse):.4f}m')
        axes[1].set_ylabel('Localization error vs GT (m)')
        axes[1].set_title('EKF vs RNN Localization Error (paper Fig 13)')
    else:
        n = len(ekf_df)
        err_diff = pos_error(ekf_df['ekf_x'].values[:n], ekf_df['ekf_y'].values[:n],
                             rnn_x[:n], rnn_y[:n])
        axes[1].plot(err_diff, color='purple', linewidth=1,
                     label='EKF vs RNN difference')
        axes[1].set_ylabel('Position difference (m)')
        axes[1].set_title('EKF vs RNN Difference Over Time')

    axes[1].set_xlabel('Time step')
    axes[1].legend()
