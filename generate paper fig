# FIGURE 7 — Full pipeline master figure
# ══════════════════════════════════════════════════════════════════════════════

def figure7_full_pipeline():
    ekf_df   = pd.read_csv(p('ekf_fused_output'))
    rnn_df   = pd.read_csv(p('rnn_smoothed_output'))
    final_df = pd.read_csv(p('final_fused_output_v2'))
    t_grid   = get_timestamp(ekf_df)
    gt_x, gt_y = load_gt(t_grid)

    rnn_native_t   = get_timestamp(rnn_df)
    final_native_t = get_timestamp(final_df)
    rnn_x = np.interp(t_grid, rnn_native_t, rnn_df['rnn_x'].values)
    rnn_y = np.interp(t_grid, rnn_native_t, rnn_df['rnn_y'].values)
    fx    = np.interp(t_grid, final_native_t, final_df['final_x'].values)
    fy    = np.interp(t_grid, final_native_t, final_df['final_y'].values)
    # FIX: same root cause as Fig 4 — np.interp clamps (doesn't
    # extrapolate) for t_grid points before each source's own first
    # timestamp (RNN/Fusion both start WINDOW_SIZE steps later than EKF),
    # silently repeating the first real value across the leading rows.
    # Fine for the plotted trajectory lines, but was corrupting the RNN/
    # Fusion RMSE in subplot 5's legend. Masks below restrict RMSE to each
    # source's own valid (non-clamped) range.
    rnn_valid_mask   = t_grid >= rnn_native_t[0]
    final_valid_mask = t_grid >= final_native_t[0]

    fig = plt.figure(figsize=(18, 11))
    fig.suptitle('Complete EKF-RNN-LiDAR Fusion Pipeline Results',
                 fontsize=15, fontweight='bold')
    gs = gridspec.GridSpec(2, 3, figure=fig, hspace=0.45, wspace=0.35)

    def plot_traj(ax, lines, title):
        for xy, color, lw, ls, label in lines:
            ax.plot(xy[0], xy[1], color=color, linewidth=lw,
                    linestyle=ls, label=label, alpha=0.8)
        if gt_x is not None:
            ax.plot(gt_x, gt_y, color='black', linewidth=0.8,
                    linestyle='--', label='GT')
        ax.set_title(title)
        ax.set_xlabel('X (m)')
        ax.set_ylabel('Y (m)')
        ax.legend(fontsize=7)
        ax.grid(True)
        ax.axis('equal')

    # 1. Raw odometry
    plot_traj(fig.add_subplot(gs[0, 0]),
              [((ekf_df['odom_x'], ekf_df['odom_y']), 'orange', 1, '-', 'Odom')],
              '1. Raw Odometry')

    # 2. EKF output
    plot_traj(fig.add_subplot(gs[0, 1]),
              [((ekf_df['odom_x'], ekf_df['odom_y']), 'orange', 0.7, '-', 'Odom'),
               ((ekf_df['ekf_x'],  ekf_df['ekf_y']),  'blue',   1.2, '-', 'EKF')],
              '2. After EKF Fusion')

    # 3. RNN output
    plot_traj(fig.add_subplot(gs[0, 2]),
              [((ekf_df['ekf_x'], ekf_df['ekf_y']), 'blue',  0.7, '-', 'EKF'),
               ((rnn_x,           rnn_y),            'green', 1.2, '-', 'RNN')],
              '3. After RNN Correction')

    # 4. Final fused
    plot_traj(fig.add_subplot(gs[1, 0]),
              [((rnn_x, rnn_y), 'green',  0.7, '-', 'RNN'),
               ((fx,    fy),    'purple', 1.2, '-', 'Final')],
              '4. Final LiDAR Fusion')

    # 5. Error comparison vs GT
    ax5 = fig.add_subplot(gs[1, 1])
    if gt_x is not None:
        n = min(len(ekf_df), len(gt_x))
        for vals, color, label, mask in [
            ((ekf_df['odom_x'].values, ekf_df['odom_y'].values), 'orange', 'Odom', None),
            ((ekf_df['ekf_x'].values,  ekf_df['ekf_y'].values),  'blue',   'EKF', None),
            ((rnn_x,                   rnn_y),                   'green',  'RNN', rnn_valid_mask),
            ((fx,                      fy),                      'purple', 'Fusion', final_valid_mask),
        ]:
            err = pos_error(vals[0][:n], vals[1][:n], gt_x[:n], gt_y[:n])
            # RMSE excludes clamped-padding rows for RNN/Fusion (see FIX
            # above) — plotted line still shows the full array.
            err_for_rmse = err[mask[:n]] if mask is not None else err
            ax5.plot(err, linewidth=0.8, color=color,
                     label=f'{label} ({rmse(err_for_rmse):.3f}m)', alpha=0.8)
        ax5.set_ylabel('Error vs GT (m)')
    ax5.set_title('5. All Methods vs GT Error')
    ax5.set_xlabel('Time step')
    ax5.legend(fontsize=7)
    ax5.grid(True)

    # 6. RMSE bar chart
    ax6 = fig.add_subplot(gs[1, 2])
    results_df = pd.read_csv(os.path.join(LOG_DIR, 'noise_evaluation_results.csv'))
    x     = np.arange(len(results_df))
    width = 0.25
    ax6.bar(x - width, results_df['EKF Only (m)'],       width,
            label='EKF',    color='steelblue')
    ax6.bar(x,          results_df['RNN Only (m)'],        width,
            label='RNN',    color='darkorange')
    ax6.bar(x + width,  results_df['EKF-RNN Fusion (m)'], width,
            label='Fusion', color='seagreen')
    ax6.set_title('6. RMSE vs Noise Level')
    ax6.set_xticks(x)
    ax6.set_xticklabels(results_df['Noise Level'])
    ax6.set_ylabel('RMSE (m)')
    ax6.legend(fontsize=7)
    ax6.grid(True, axis='y', alpha=0.3)

    save('paper_figure7_full_pipeline.png')


