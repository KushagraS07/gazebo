# FIGURE 10 — Metrics summary (paper Table 7)
# ══════════════════════════════════════════════════════════════════════════════

def figure10_metrics_summary():
    ekf_df   = pd.read_csv(p('ekf_fused_output'))
    rnn_df   = pd.read_csv(p('rnn_smoothed_output'))
    final_df = pd.read_csv(p('final_fused_output_v2'))
    t_grid   = get_timestamp(ekf_df)
    gt_x, gt_y = load_gt(t_grid)

    if gt_x is None:
        print("  Skipping Fig 10 — no ground truth available")
        return

    rnn_native_t   = get_timestamp(rnn_df)
    final_native_t = get_timestamp(final_df)
    rnn_x  = np.interp(t_grid, rnn_native_t,   rnn_df['rnn_x'].values)
    rnn_y  = np.interp(t_grid, rnn_native_t,   rnn_df['rnn_y'].values)
    fx     = np.interp(t_grid, final_native_t, final_df['final_x'].values)
    fy     = np.interp(t_grid, final_native_t, final_df['final_y'].values)

    n = min(len(gt_x), len(ekf_df))
    # FIX: same root cause as Fig 4/Fig 7 — np.interp clamps rnn_x/rnn_y
    # and fx/fy to their first real value for t_grid points before each
    # source's own native start (RNN/Fusion both start WINDOW_SIZE steps
    # later than EKF). Excluding those points here (RNN/Fusion only, not
    # EKF/Odometry which have no such padding) keeps this figure's RMSE
    # consistent with rnn_fusion_v2.py's own reported number and with
    # Fig 4/Fig 5/Fig 11.
    rnn_valid   = (t_grid >= rnn_native_t[0])[:n]
    final_valid = (t_grid >= final_native_t[0])[:n]
    methods = ['Odometry', 'EKF', 'RNN', 'Final Fusion']
    data    = [
        (ekf_df['odom_x'].values[:n], ekf_df['odom_y'].values[:n], None),
        (ekf_df['ekf_x'].values[:n],  ekf_df['ekf_y'].values[:n],  None),
        (rnn_x[:n],                   rnn_y[:n],                   rnn_valid),
        (fx[:n],                      fy[:n],                      final_valid),
    ]
    # Paper Table 7 std values for reference
    paper_std = [0.1254, 0.0619, 0.0527, None]

    rmses, maes, stds = [], [], []
    for px, py, mask in data:
        err = pos_error(px, py, gt_x[:n], gt_y[:n])
        err_for_metrics = err[mask] if mask is not None else err
        rmses.append(rmse(err_for_metrics))
        maes.append(float(np.mean(err_for_metrics)))
        stds.append(float(np.std(err_for_metrics)))

    fig, ax = plt.subplots(1, 1, figsize=(9, 6))

    x     = np.arange(len(methods))
    width = 0.25
    ax.bar(x - width, rmses, width, label='RMSE', color='steelblue')
    ax.bar(x,          maes,  width, label='MAE',  color='darkorange')
    ax.bar(x + width,  stds,  width, label='Std',  color='seagreen')
    ax.set_xticks(x)
    ax.set_xticklabels(methods)
    ax.set_ylabel('Error (m)')
    ax.legend()
    ax.grid(True, axis='y', alpha=0.3)

    plt.tight_layout()
    save('paper_figure10_metrics_summary.png')


