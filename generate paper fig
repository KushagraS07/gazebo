#!/usr/bin/env python3
"""
generate_paper_figures.py — All 7 figures matching paper + runtime/disturbance/metrics

Figures generated:
  Fig 1: Raw sensor data collection        (paper Fig 6)
  Fig 2: S-G filtering comparison          (paper Fig 7-8)
  Fig 3: EKF trajectory + GT error         (paper Fig 12)
  Fig 4: RNN localization error vs GT      (paper Fig 13)
  Fig 5: LiDAR fusion trajectory + GT      (paper Fig 13)
  Fig 6: Noise comparison 3-bar chart      (paper Fig 9)
  Fig 7: Full pipeline master figure
  Fig 8: Runtime breakdown                 (paper Table 8)
  Fig 9: Dynamic disturbance comparison    (paper Table 4)
  Fig 10: Metrics summary (std dev)        (paper Table 7)
"""

import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import matplotlib.gridspec as gridspec
import os
import sys
import glob

LOG_DIR = os.path.expanduser('~/ws_mobile/sensor_logs')

# FIX (multi-session support): every figure function used to hardcode fixed
# filenames (ekf_fused_output.csv, rnn_smoothed_output.csv, etc.) which no
# longer exist — every pipeline stage now saves session-tagged output
# (ekf_fused_output_<session>.csv). These figures illustrate ONE
# representative trajectory (matching the paper's own approach of showing
# one simulation run per fusion stage, not overlaying multiple sessions),
# so pick a single session here rather than looping over all three.
# 20260712_144326 was chosen since it's the session most thoroughly
# diagnosed and verified throughout this project's debugging.
# FIX: now a command-line argument (matching ekf_fusion.py's convention)
# instead of a hardcoded constant you had to edit every time — run e.g.
#   python3 generate_paper_figures.py 20260712_141740
# to generate figures for a different session; omit it to use the
# representative session as before.
SESSION = sys.argv[1] if len(sys.argv) > 1 else '20260712_144326'


def p(prefix: str) -> str:
    """Path to this session's tagged file, e.g. p('ekf_fused_output') ->
    .../ekf_fused_output_20260712_144326.csv"""
    return os.path.join(LOG_DIR, f'{prefix}_{SESSION}.csv')


# ══════════════════════════════════════════════════════════════════════════════
# HELPERS
# ══════════════════════════════════════════════════════════════════════════════

def load_latest(prefix, exclude=None):
    """FIX: still used for truly session-agnostic files (none currently),
    kept for compatibility but no longer used for per-session pipeline
    outputs — those now go through p() to target SESSION explicitly."""
    files = glob.glob(os.path.join(LOG_DIR, f'{prefix}_*.csv'))
    if exclude:
        files = [f for f in files if not any(e in f for e in exclude)]
    if not files:
        raise FileNotFoundError(f"No CSV for '{prefix}' in {LOG_DIR}")
    return pd.read_csv(max(files, key=os.path.getctime))


def get_timestamp(df):
    if 'timestamp' in df.columns:
        return df['timestamp'].values.astype(float)
    elif 'time_sec' in df.columns:
        return df['time_sec'].values + df['time_nsec'].values * 1e-9
    return np.arange(len(df)) / 50.0


def load_gt(t_grid):
    """Load ground truth interpolated onto t_grid.
    FIX: previously ctime-globbed across raw/stage/filtered ground_truth
    variants for whichever session happened to be processed most recently
    — could silently load an uncleaned file, or a different session's GT
    entirely. Now explicitly targets SESSION's canonical, cleaned,
    continuity-fixed, resampled ground_truth_filtered file."""
    path = p('ground_truth_filtered')
    if not os.path.exists(path):
        print(f"  ⚠️  {os.path.basename(path)} not found — no ground truth "
              f"available for session {SESSION}.")
        return None, None
    gt_df = pd.read_csv(path)
    gt_t  = get_timestamp(gt_df)
    gt_x  = np.interp(t_grid, gt_t, gt_df['gt_x'].values.astype(float))
    gt_y  = np.interp(t_grid, gt_t, gt_df['gt_y'].values.astype(float))
    return gt_x, gt_y


def pos_error(px, py, gt_x, gt_y):
    return np.sqrt((px - gt_x)**2 + (py - gt_y)**2)


def rmse(err):
    return float(np.sqrt(np.mean(err**2)))


def quat_to_yaw(oz, ow):
    return float(np.arctan2(2.0 * ow * oz, 1.0 - 2.0 * oz * oz))


def imu_dead_reckoning(imu_df, init_x, init_y, init_theta):
    """
    Standalone IMU-only position estimate via double-integration of
    body-frame linear acceleration, using the IMU's own absolute
    orientation (orient_z/orient_w -> theta) for the world-frame rotation
    (not re-integrating angular_vel_z — this project's EKF debugging
    already found IMU absolute orientation is near-exact, ~0.04deg mean
    error vs GT, so re-deriving heading from rate data would just
    reintroduce that same error for no benefit).

    HONEST EXPECTATION: this WILL drift substantially and look far worse
    than odometry/EKF — that's the real, well-known behavior of
    accelerometer double-integration (error grows ~quadratically with
    time), and matches the paper's own description of IMU: "substantial
    cumulative errors and inaccuracies, making it difficult to ensure
    reliable positioning" (paper, Data preprocessing section). A drifting
    IMU trace here is the CORRECT outcome, not a bug.
    """
    t = get_timestamp(imu_df)
    n = len(t)
    oz = imu_df['orient_z'].values.astype(float)
    ow = imu_df['orient_w'].values.astype(float)
    theta = np.array([quat_to_yaw(oz[i], ow[i]) for i in range(n)])
    ax = imu_df['linear_acc_x'].values.astype(float)
    ay = imu_df['linear_acc_y'].values.astype(float)

    x, y = np.zeros(n), np.zeros(n)
    x[0], y[0] = init_x, init_y
    vx, vy = 0.0, 0.0

    for i in range(1, n):
        dt = float(t[i] - t[i - 1])
        dt = np.clip(dt, 0.001, 0.5)
        th = theta[i - 1]
        ax_world = ax[i - 1] * np.cos(th) - ay[i - 1] * np.sin(th)
        ay_world = ax[i - 1] * np.sin(th) + ay[i - 1] * np.cos(th)
        vx += ax_world * dt
        vy += ay_world * dt
        x[i] = x[i - 1] + vx * dt
        y[i] = y[i - 1] + vy * dt

    return x, y, theta


def adaptive_xy_limits(ax, ref_x_arrays, ref_y_arrays, pad_frac=0.15):
    """Sets axis limits based on the REFERENCE traces (e.g. GT + odometry),
    not on whatever else is plotted (e.g. a drifting IMU trace). If IMU
    dead-reckoning drifts far outside this range, it will simply run off
    the edge of the plot — annotate_offchart() below reports where it
    actually went, rather than silently clipping without saying so."""
    all_x = np.concatenate(ref_x_arrays)
    all_y = np.concatenate(ref_y_arrays)
    x_range = all_x.max() - all_x.min()
    y_range = all_y.max() - all_y.min()
    ax.set_xlim(all_x.min() - pad_frac * x_range, all_x.max() + pad_frac * x_range)
    ax.set_ylim(all_y.min() - pad_frac * y_range, all_y.max() + pad_frac * y_range)


def annotate_offchart(ax, label, x_arr, y_arr, ref_x_arrays, ref_y_arrays):
    """If `label`'s trace (x_arr,y_arr) drifts well beyond the reference
    traces' range (e.g. IMU dead-reckoning vs GT/odometry), the axis limits
    set by adaptive_xy_limits() will cut it off — add a text note reporting
    the real max excursion so the drift magnitude isn't silently hidden."""
    all_x = np.concatenate(ref_x_arrays)
    all_y = np.concatenate(ref_y_arrays)
    ref_extent = max(all_x.max() - all_x.min(), all_y.max() - all_y.min())
    max_excursion = float(np.max(np.hypot(x_arr - x_arr[0], y_arr - y_arr[0])))
    if max_excursion > 2.5 * ref_extent:
        ax.text(0.02, 0.02,
                 f"{label} drifts off-chart\n(max {max_excursion:.1f}m from start —\n"
                 f"real accelerometer drift, not a bug)",
                 transform=ax.transAxes, fontsize=8, va='bottom',
                 bbox=dict(boxstyle='round', facecolor='lightyellow', alpha=0.9))


def save(name):
    path = os.path.join(LOG_DIR, name)
    plt.savefig(path, dpi=300, bbox_inches='tight')
    print(f"  Saved: {name}")
    plt.close()


