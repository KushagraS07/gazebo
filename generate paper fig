# FIGURE 11 — Error distribution histogram (paper's actual Fig 10)
# Uses error_distribution_results.csv from noise_evaluation.py — real
# per-timestep error samples from one clean run per method, NOT a
# multi-seed Monte Carlo distribution (see noise_evaluation.py's
# evaluate_error_distribution() docstring for why that's the right call).
# ══════════════════════════════════════════════════════════════════════════════

def figure11_error_distribution():
    path = os.path.join(LOG_DIR, 'error_distribution_results.csv')
    if not os.path.exists(path):
        print("  Skipping Fig 11 — error_distribution_results.csv not found "
              "(re-run the updated noise_evaluation.py)")
        return

    err_df = pd.read_csv(path)

    # FIX (visualization complaint: "curves overlap too much"): color +
    # linestyle differentiation still can't fully fix 4 series crammed onto
    # 1 axis when 2 of them are near-identical distributions. Small
    # multiples (one subplot per method, shared x/y axes for direct visual
    # comparison) eliminates the overlap problem entirely instead of
    # fighting it with styling.
    methods = ['EKF Only', 'RNN Only', 'EKF + Weighted Fusion', 'EKF-RNN Fusion']
    methods = [m for m in methods if m in err_df.columns]
    colors  = {'EKF Only': 'tab:blue', 'RNN Only': 'tab:orange',
               'EKF + Weighted Fusion': 'tab:green', 'EKF-RNN Fusion': 'tab:red'}

    xmax = err_df[methods].max().max()
    ymax = 0
    for m in methods:
        counts, _ = np.histogram(err_df[m], bins=30, density=True)
        ymax = max(ymax, counts.max())

    fig, axes = plt.subplots(2, 2, figsize=(11, 8), sharex=True, sharey=True)
    for ax, method in zip(axes.flat, methods):
        ax.hist(err_df[method], bins=30, density=True, color=colors[method],
                alpha=0.75)
        ax.set_title(f'{method}  (RMSE={rmse(err_df[method].values):.4f}m)',
                     fontsize=10)
        ax.set_xlim(0, xmax * 1.05)
        ax.set_ylim(0, ymax * 1.1)
        ax.grid(True, alpha=0.3)
    for ax in axes[-1, :]:
        ax.set_xlabel('Localization Error (meters)')
    for ax in axes[:, 0]:
        ax.set_ylabel('Probability Density')

    fig.suptitle('Figure 11: Error Distribution by Method (paper Fig 10)',
                  fontsize=13, fontweight='bold')

    plt.tight_layout()
    save('paper_figure11_error_distribution.png')


